# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Generated by tool/coverage.dart
/test/_coverage_helper_test.dart

# Release secrets and Fastlane output (the keystore itself is ignored by android/.gitignore)
play-service-account*.json
/android/fastlane/report.xml
/android/vendor/
/android/.bundle/
/android/fastlane/README.md

# Signing keys and credentials, ignored at any depth as a safety net
*.jks
*.keystore
key.properties
play-service-account*.json

# Flutter DevTools local settings
devtools_options.yaml
